PORT=5000
# Neon connection string (Neon console -> Connect, pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Random 32+ char secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace_me
# Public URL of the FRONTEND (auth requests are proxied through it)
BETTER_AUTH_URL=http://localhost:5173
# Optional: extra comma-separated origins allowed to call the auth API
TRUSTED_ORIGINS=
# Optional: enables "Continue with Google". Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
